#!/usr/bin/env bash

## SSH 鍵が無いと下の clone が全リポジトリ分 Permission denied を並べるだけで
## 何をすべきか分からないため、先に 1 回だけ疎通確認して案内する
if ! ssh -T -o BatchMode=yes -o StrictHostKeyChecking=accept-new git@github.com 2>&1 | grep -q 'successfully authenticated'; then
    echo "ERROR: GitHub への SSH 認証に失敗しました。鍵を作成し GitHub に登録してください。"
    echo "       ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_git"
    echo "       gh ssh-key add ~/.ssh/id_ed25519_git.pub"
    exit 1
fi

REPO_DIR=${REPO_DIR:-"$HOME/Repositories"}
mkdir -p $REPO_DIR
cd $REPO_DIR
repos=(
  fout/fout
  fout/fout_logs
  fout/fout_infra
  fout/fout_fm
  fout/fout_ui
  fout/fout_hubot
  fout/fout_webhook
  fout/fout_analysis
  fout/fout_ukigumo
  fout/fout_notebooks
  fout/fout_crawler
  fout/fout_text_labeler
  doiken/fout_sandbox
  doiken/cpp_test
  doiken/perl
  doiken/python
)
for r in ${repos[@]}; do
    git clone "git@github.com:${r}.git" 2>&1 | grep -v 'already exists'
done

## App のインストールは setup.sh の brew bundle が Brewfile 経由で Brewfile.fout ごと扱う

# for fout box
docker_env=(
  fout
  fout_logs
)
{
  for env in ${docker_env[@]}; do
    cd ~/Repositories/fout_sandbox/unittest/$env
    docker-compose up -d
    docker-compose exec perl /bin/bash -lc /unittest/setup.sh
    docker-compose down
  done
} &

# hammerspoon
{
  for f in $(echo ~/.hammerspoon/fout/*); do
		test -f ~/.hammerspoon/Spoons/$(basename $f) || ln -s $f ~/.hammerspoon/Spoons/$(basename $f)
  done
} &

##
## claude
##
# plugin (fout_sandbox/claude) は settings.json の extraKnownMarketplaces/enabledPlugins 宣言で自動導入されるためここでは扱わない
# Redmine MCP。API キーは Keychain 由来の $REDMINE_API_KEY (.zshrc.d/fout.zsh) を実行時展開。
# 新マシンでは初回のみ: security add-generic-password -s redmine-api-key -a $USER -w '<APIキー>'
{
  claude mcp list 2>/dev/null | grep -q 'redmine-mcp-api' \
    || claude mcp add --scope user --transport http redmine-mcp-api http://localhost:8023/v2/mcp --header 'X-Redmine-API-Key: ${REDMINE_API_KEY}'
} &

wait
